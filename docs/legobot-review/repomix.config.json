{
  "output": {
    "filePath": "docs/legobot-review/legobot-review-bundle.xml",
    "style": "xml",
    "fileSummary": true,
    "directoryStructure": true,
    "showLineNumbers": true,
    "removeComments": false,
    "removeEmptyLines": false
  },
  "include": [
    "README.md",
    "ARCHITECTURE.md",
    "PHYSICS.md",
    "simulation/CONDITIONS.md",

    "config.py",
    "legobot_config.py",

    "hardware/legobot/*.md",
    "hardware/legobot/*.py",
    "hardware/legobot/*.sh",
    "hardware/legobot/robot/**/*.py",
    "hardware/legobot/robot/**/*.sh",
    "hardware/legobot/bench_data/*_fit.json",

    "simulation/balance_sim/*.py",
    "simulation/batch_sim/*.py",
    "simulation/examples/physics_checks.py",
    "simulation/examples/datasheet_numbers.py",

    "simulation/tests/test_slow_pwm.py",
    "simulation/tests/test_imu.py",
    "simulation/tests/test_encoder.py",
    "simulation/tests/test_voltage_mode.py",
    "simulation/tests/test_equivalence.py",
    "simulation/tests/test_torch.py",
    "simulation/tests/test_friction_latency.py",
    "simulation/tests/test_linear_stability.py",
    "simulation/tests/test_conditions.py",

    "optimization/batch_tuning/*.py",
    "optimization/run_batch_tuning.py",
    "optimization/tuning/evaluation.py",
    "optimization/tuning/search_space.py",
    "optimization/tests/test_config.py",
    "optimization/tests/test_robust.py",
    "optimization/tests/test_batch_tuning.py"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": ["**/__pycache__/**"]
  }
}
